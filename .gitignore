*.lnk

### Editor temporary files and backups ###
*~
*.swp
*.swo
*.bak
*.orig

### Local environment and private configuration ###
.env
.env.*
!.env.example
!.env.*.example
/src/main/resources/application-local.properties
/src/main/resources/application-local.yml
/src/main/resources/application-local.yaml
/src/main/resources/application-secret.properties
/src/main/resources/application-secret.yml
/src/main/resources/application-secret.yaml
/compose.override.yml
/compose.override.yaml
/docker-compose.override.yml
/docker-compose.override.yaml
/secrets/
*.key
*.p12
*.pfx
*.jks
*.keystore

### Docker bind-mounted runtime data ###
# Use docker-data/<service>/ for future PostgreSQL, Redis and monitoring data.
# Named volumes and downloaded Docker images live outside this repository.
/docker-data/
# Also cover service-specific local data paths.
/docker/postgres/data/
/docker/postgresql/data/
/docker/redis/data/
/docker/prometheus/data/
/docker/grafana/data/
# Keep Dockerfile, Compose files, shared config and migration SQL in Git.

### Logs, local database backups and reports ###
*.log
/logs/
/backups/
*.dump
*.sql.gz
dump.rdb
appendonly.aof
appendonlydir/
/coverage/
