# Based on the user-provided gitignore.io templates:
# macOS, Windows, Java, IntelliJ IDEA and Visual Studio Code.
# Adapted for FindUs: Java / Gradle / Spring Boot / Docker Compose.
# IDE settings are local; build.gradle and the Gradle Wrapper are shared.

### Gradle ###
.gradle/
.kotlin/
build/

### Java build output and crash reports ###
*.class
*.jar
*.war
*.nar
*.ear
# Required to build without a separately installed Gradle.
!/gradle/wrapper/gradle-wrapper.jar
hs_err_pid*
replay_pid*
.mtj.tmp/
*.ctxt

### IntelliJ IDEA / JetBrains ###
.idea/
*.iml
*.ipr
*.iws
out/
.idea_modules/
atlassian-ide-plugin.xml

### Visual Studio Code ###
.vscode/
*.code-workspace
.history/
.localhistory/
*.vsix

### Other Java IDE generated settings ###
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
bin/

### macOS ###
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100/
.fseventsd/
.Spotlight-V100/
.TemporaryItems/
.Trashes/
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder/
Temporary Items/
.apdisk
*.icloud

### Windows ###
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
