# 이 파일을 프로젝트 루트의 .env로 복사한 뒤 개인 개발 설정을 입력하세요.
# 실제 비밀번호가 들어 있는 .env는 Git에 올리지 않습니다.
# UTF-8로 저장하고 KEY=value 형식으로 작성하세요.
# 값에 따옴표, 공백, 역슬래시, ${...}를 넣거나 줄 끝에 주석을 붙이지 마세요.
# export 문법을 사용하지 않습니다. 주석은 별도 줄에 작성하세요.
# 로컬 비밀번호는 길고 무작위인 영문·숫자 조합을 권장합니다.
# 실행 프로필은 OS·IDE 환경변수로 지정합니다. SPRING_PROFILES_ACTIVE는 여기에 넣지 마세요.

# 백엔드 서버 포트입니다. 이미 사용 중이라면 다른 번호로 바꾸세요.
SERVER_PORT=18080

# PostgreSQL: 백엔드는 내 컴퓨터에서 실행하고 DB는 Docker에서 실행합니다.
# 내 컴퓨터와 컨테이너 내부 모두 15432 포트를 사용합니다.
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=findus
POSTGRES_USER=findus
# 아래 예시를 개인 로컬 비밀번호로 바꿔주세요.
POSTGRES_PASSWORD=replace_with_local_password

# Redis: 비밀번호 인증을 사용하며 AOF로 데이터를 디스크에 기록합니다.
REDIS_HOST=localhost
REDIS_PORT=16379
# 아래 예시를 개인 로컬 비밀번호로 바꿔주세요.
REDIS_PASSWORD=replace_with_local_password

# 32바이트 이상의 무작위 값을 Base64로 인코딩한 JWT 서명 키를 입력하세요.
# macOS: openssl rand -base64 32
# Windows: 아래 생성 방법은 README를 참고하세요.
JWT_SECRET=replace_with_base64_encoded_random_key
# 토큰 만료 시간입니다. m은 분, d는 일입니다.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# 로컬 HTTP에서는 false, 배포 HTTPS에서는 true로 설정하세요.
AUTH_COOKIE_SECURE=false
# 쿠키를 포함한 요청을 허용할 프론트 주소입니다. 와일드카드는 사용하지 않습니다.
FRONTEND_ORIGIN=http://localhost:5173
