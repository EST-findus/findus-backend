# Copy to .env in the project root. Never commit actual credentials.
# Use UTF-8, KEY=value, no quotes, no export, and no inline comments.
# Avoid backslashes, ${...}, spaces and quotes in values for Compose compatibility.
# Do not set SPRING_PROFILES_ACTIVE here: select profiles via OS/IDE/CLI.

# Used now. Change this port if 8080 is already occupied.
SERVER_PORT=8080

# Reserved for step 3: local PostgreSQL (not connected yet).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=findus
POSTGRES_USER=findus
POSTGRES_PASSWORD=replace_with_local_password

# Reserved for step 3: local Redis (not connected yet).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_local_password
