# 이 파일을 프로젝트 루트의 .env로 복사한 뒤 개인 개발 설정을 입력하세요.
# 실제 비밀번호가 들어 있는 .env는 Git에 올리지 않습니다.
# UTF-8로 저장하고 KEY=value 형식으로 작성하세요.
# 값에 따옴표, 공백, 역슬래시, ${...}를 넣거나 줄 끝에 주석을 붙이지 마세요.
# export 문법을 사용하지 않습니다. 주석은 별도 줄에 작성하세요.
# 로컬 비밀번호는 길고 무작위인 영문·숫자 조합을 권장합니다.
# 실행 프로필은 OS·IDE 환경변수로 지정합니다. SPRING_PROFILES_ACTIVE는 여기에 넣지 마세요.

# 백엔드 서버 포트입니다. 이미 사용 중이라면 다른 번호로 바꾸세요.
SERVER_PORT=18080

# PostgreSQL: 백엔드는 내 컴퓨터에서 실행하고 DB는 Docker에서 실행합니다.
# 내 컴퓨터와 컨테이너 내부 모두 15432 포트를 사용합니다.
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=findus
POSTGRES_USER=findus
# 아래 예시를 개인 로컬 비밀번호로 바꿔주세요.
POSTGRES_PASSWORD=replace_with_local_password

# Redis: 비밀번호 인증을 사용하며 AOF로 데이터를 디스크에 기록합니다.
REDIS_HOST=localhost
REDIS_PORT=16379
# 아래 예시를 개인 로컬 비밀번호로 바꿔주세요.
REDIS_PASSWORD=replace_with_local_password

# 32바이트 이상의 무작위 값을 Base64로 인코딩한 JWT 서명 키를 입력하세요.
# macOS: openssl rand -base64 32
# Windows: 아래 생성 방법은 README를 참고하세요.
JWT_SECRET=replace_with_base64_encoded_random_key
# 토큰 만료 시간입니다. m은 분, d는 일입니다.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# 로컬 HTTP에서는 false, 배포 HTTPS에서는 true로 설정하세요.
AUTH_COOKIE_SECURE=false
# 쿠키를 포함한 요청을 허용할 프론트 주소입니다. 와일드카드는 사용하지 않습니다.
FRONTEND_ORIGIN=http://localhost:5173

# Prometheus가 메트릭을 읽을 때 사용하는 비밀번호입니다. 아이디는 prometheus입니다.
# 24자 이상의 무작위 영문·숫자 값을 입력하세요. 회원 로그인 비밀번호와는 별개입니다.
PROMETHEUS_PASSWORD=replace_with_random_prometheus_password
# Grafana 최초 관리자 비밀번호입니다. 아이디는 admin입니다.
# Docker 볼륨에 계정이 만들어진 이후에는 Grafana 화면에서 비밀번호를 변경합니다.
GRAFANA_ADMIN_PASSWORD=replace_with_random_grafana_password

# 로컬 더미 데이터 기능입니다. 실제 .env에는 필요한 경우에만 추가하세요.
# 전체 기능을 끄려면 false, 시작 때 갱신만 끄려면 아래 두 번째 항목을 false로 설정합니다.
DUMMY_DATA_ENABLED=true
DUMMY_STARTUP_ENABLED=true
# 개발용 가상 회원의 공통 비밀번호입니다. 실제 회원 비밀번호로 사용하지 마세요.
DUMMY_PASSWORD=Dummy-test123!

# 안전Dream 인증정보입니다. 실제 값은 Git에서 제외된 .env에만 저장하세요.
SAFE182_ESNTL_ID=
SAFE182_AUTH_KEY=
SAFE182_BASE_URL=https://www.safe182.go.kr
# 배포 환경에서 true로 켜면 매일 한국 시간 04:00·16:00에 실행됩니다.
MISSING_SCHEDULE_ENABLED=false
