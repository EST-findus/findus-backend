{
  "uid": "findus-redis",
  "title": "FindUs Redis 상태",
  "description": "Redis의 연결·메모리·키·명령 처리 상태입니다. 키 이름이나 로그인 토큰 값은 수집하지 않습니다.",
  "tags": [
    "FindUs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "links": [
    {
      "title": "백엔드",
      "type": "link",
      "url": "/d/findus-backend",
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "JVM 상세",
      "type": "link",
      "url": "/d/findus-jvm",
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "PostgreSQL",
      "type": "link",
      "url": "/d/findus-postgres",
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Redis",
      "type": "link",
      "url": "/d/findus-redis",
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "요청·DB 트랜잭션",
      "type": "link",
      "url": "/d/findus-transactions",
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Redis 연결 상태",
      "description": "exporter가 Redis에 연결할 수 있으면 1입니다.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_up{job=\"findus-redis\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "연결 실패",
                  "color": "red"
                },
                "1": {
                  "text": "연결 정상",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "연결된 클라이언트 수",
      "description": "백엔드와 exporter를 포함한 현재 연결 수입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_connected_clients{job=\"findus-redis\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "Redis 메모리 사용량",
      "description": "Redis가 할당한 메모리와 운영체제가 보는 실제 상주 메모리를 비교합니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_memory_used_bytes{job=\"findus-redis\"}",
          "legendFormat": "할당 메모리"
        },
        {
          "refId": "B",
          "expr": "redis_memory_used_rss_bytes{job=\"findus-redis\"}",
          "legendFormat": "상주 메모리"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "title": "초당 처리 명령 수",
      "description": "최근 1분 동안 Redis가 처리한 명령 수의 초당 평균입니다. 수집용 INFO 명령도 포함됩니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(redis_commands_processed_total{job=\"findus-redis\"}[1m])",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 5,
      "title": "전체 키 수",
      "description": "모든 Redis DB에 저장된 키 개수이며 키의 이름·값은 표시하지 않습니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(redis_db_keys{job=\"findus-redis\"})",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "title": "캐시 조회 적중률",
      "description": "최근 5분의 키 조회 적중률입니다. 조회가 없으면 0으로 표시됩니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(redis_keyspace_hits_total{job=\"findus-redis\"}[5m])) / clamp_min(sum(rate(redis_keyspace_hits_total{job=\"findus-redis\"}[5m])) + sum(rate(redis_keyspace_misses_total{job=\"findus-redis\"}[5m])), 0.000001)",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 7,
      "title": "초당 만료·강제 제거 키 수",
      "description": "만료는 TTL이 지난 키, 강제 제거는 메모리 정책에 의해 제거된 키입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(redis_expired_keys_total{job=\"findus-redis\"}[1m])",
          "legendFormat": "만료"
        },
        {
          "refId": "B",
          "expr": "rate(redis_evicted_keys_total{job=\"findus-redis\"}[1m])",
          "legendFormat": "강제 제거"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 8,
      "title": "Redis 실행 시간",
      "description": "Redis 프로세스를 시작한 후 지난 시간입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_uptime_in_seconds{job=\"findus-redis\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    }
  ]
}
