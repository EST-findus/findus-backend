{
  "uid": "findus-transactions",
  "title": "FindUs 요청·DB 트랜잭션",
  "description": "API 요청과 DB 트랜잭션의 단위는 다릅니다. DB 통계는 exporter 등 전체 활동을 포함하며 Spring 메서드별 트랜잭션 추적 화면은 아닙니다.",
  "tags": [
    "FindUs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "links": [
    {
      "title": "백엔드",
      "type": "link",
      "url": "/d/findus-backend",
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "JVM 상세",
      "type": "link",
      "url": "/d/findus-jvm",
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "PostgreSQL",
      "type": "link",
      "url": "/d/findus-postgres",
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Redis",
      "type": "link",
      "url": "/d/findus-redis",
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "요청·DB 트랜잭션",
      "type": "link",
      "url": "/d/findus-transactions",
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "초당 API 요청 수",
      "description": "HTTP 요청 처리량입니다. 트랜잭션 커밋 수가 아닙니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"findus-backend\",job=\"findus-backend\",uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "title": "초당 DB 커밋·롤백 수",
      "description": "findus DB 전체에서 완료된 트랜잭션 수입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_xact_commit{job=\"findus-postgres\",datname=\"findus\"}[1m])",
          "legendFormat": "커밋"
        },
        {
          "refId": "B",
          "expr": "rate(pg_stat_database_xact_rollback{job=\"findus-postgres\",datname=\"findus\"}[1m])",
          "legendFormat": "롤백"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "최근 5분 DB 롤백 수",
      "description": "취소한 트랜잭션 수입니다. 롤백 자체가 항상 장애나 API 오류를 뜻하지는 않습니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(pg_stat_database_xact_rollback{job=\"findus-postgres\",datname=\"findus\"}[5m])",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "title": "API 응답 시간 p95",
      "description": "최근 5분간 요청의 약 95%가 이 시간 안에 끝났습니다. 요청이 없으면 값이 없습니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"findus-backend\",job=\"findus-backend\",uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 5,
      "title": "사용 중·대기 중 DB 연결",
      "description": "Hikari 풀에서 현재 사용 중인 연결과 연결을 기다리는 요청 수입니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{application=\"findus-backend\",job=\"findus-backend\"}",
          "legendFormat": "사용 중"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_pending{application=\"findus-backend\",job=\"findus-backend\"}",
          "legendFormat": "대기 중"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "title": "초당 HTTP 5xx 오류 수",
      "description": "서버가 5xx로 응답한 요청 수입니다. DB 롤백 횟수와 일치하지 않을 수 있습니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"findus-backend\",job=\"findus-backend\",uri!~\"/actuator.*\",status=~\"5..\"}[1m])) or vector(0)",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    }
  ]
}
