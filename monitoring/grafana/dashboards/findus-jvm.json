        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "직접·매핑 버퍼 메모리",
      "description": "Direct·Mapped 버퍼의 사용량입니다. 힙 그래프만으로 보이지 않는 버퍼 메모리를 확인합니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "jvm_buffer_memory_used_bytes{application=\"findus-backend\",job=\"findus-backend\"}",
          "legendFormat": "{{id}}",
