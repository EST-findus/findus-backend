        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "최근 최대 GC 정지 시간",
      "description": "Micrometer의 최근 집계 구간 내 최대 GC 정지 시간입니다. 서버 시작 이후의 전체 최대값은 아니며 이벤트가 없으면 0 또는 값 없음으로 표시됩니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "jvm_gc_pause_seconds_max{application=\"findus-backend\",job=\"findus-backend\"}",
