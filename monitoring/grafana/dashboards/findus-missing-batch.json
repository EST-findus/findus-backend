{
  "uid": "findus-missing-batch",
  "title": "FindUs 실종자 배치",
  "description": "실행 이력은 DB에 유지됩니다. 카운터는 서버 재시작 때 초기화됩니다.",
  "tags": [
    "FindUs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-2d",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "마지막 성공 후 경과 시간",
      "description": "수집 전에는 데이터가 없습니다. 12시간 이상 길어지면 실행 이력을 확인하세요.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(findus_missing_last_success_timestamp > 0)",
          "legendFormat": "{{kind}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "배치 성공 횟수",
      "description": "서버가 실행된 동안의 누적 성공 횟수",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(findus_missing_sync_runs_total{status=\"COMPLETED\"})",
          "legendFormat": "{{kind}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "배치 실패 횟수",
      "description": "페이지 실패와 동시 실행 거절을 포함합니다.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(findus_missing_sync_runs_total{status=\"FAILED\"})",
          "legendFormat": "{{kind}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "처리 건수",
      "description": "received: 수신, inserted: 추가, updated: 변경/공개 복구, unavailable: 공개 중단",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(kind) (findus_missing_sync_records_total)",
          "legendFormat": "{{kind}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "평균 배치 실행 시간",
      "description": "성공·실패별 평균 실행 시간",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "findus-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(status)(findus_missing_sync_duration_seconds_sum) / sum by(status)(findus_missing_sync_duration_seconds_count)",
          "legendFormat": "{{kind}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
